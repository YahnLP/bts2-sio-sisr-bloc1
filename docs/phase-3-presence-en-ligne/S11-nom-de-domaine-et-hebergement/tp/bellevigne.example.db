$TTL 3600
$ORIGIN bellevigne.example.
@       IN SOA  ns1.bellevigne.example. admin.bellevigne.example. (
                2030030101 ; numéro de série (AAAAMMJJNN)
                7200       ; rafraîchissement
                900        ; nouvel essai
                1209600    ; expiration
                3600 )     ; durée de mise en cache d'une absence de réponse
        IN NS   ns1.bellevigne.example.
        IN NS   ns2.bellevigne.example.
        IN MX   10 mail.bellevigne.example.
        IN A    203.0.113.20
        IN TXT  "v=spf1 mx -all"
ns1     IN A    203.0.113.10
ns2     IN A    203.0.113.11
mail    IN A    203.0.113.40
www     IN CNAME bellevigne.example.
portail 300 IN A 203.0.113.30
